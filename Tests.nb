  Cell[BoxData[RowBox[{"propComplex[x_List] /; Length[x] == 2 && And @@ \
NumberQ /@ x := x[[1]] + I*x[[2]]; "}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[{"propClose[a_, b_, tolerance_:2.*^-9] := NumberQ[a] && \
NumberQ[b] && \n   Abs[a - b] <= tolerance*Max[1.*^-12, Abs[b]]; "}]], 
   "Input", InitializationCell -> True], 
  Cell[BoxData[RowBox[{"propSettings = Association[\"wick_pivot\" -> 1.5, \
\"wick_depth\" -> 2., \"tail_depth\" -> 4., \n   \"real_step\" -> 0.25, \
\"vertical_step\" -> 0.25, \"xmin\" -> 0.001, \"nlog\" -> 8, \"dps\" -> 30, \
\n   \"i_epsilon\" -> 0.]; "}]], "Input", InitializationCell -> True], 
  Cell[BoxData[RowBox[{"AppendTo[qsfiTestResults, \
VerificationTest[QSFIPBH`CumulativeTrapezoid[{1., 3., 5.}, {0., 1., 2.}], \n  \
{0., 2., 6.}, TestID -> \"cumulative-trapezoid\"]]"}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[{"AppendTo[qsfiTestResults, \
VerificationTest[QSFIPBH`ReverseCumulativeTrapezoid[{1.*^30, 1., 1.}, \n    \
{0., 1., 2.}][[2]], 1., TestID -> \"reverse-tail-avoids-subtraction\"]]"}]], 
   "Input", InitializationCell -> True], 
  Cell[BoxData[RowBox[{"AppendTo[qsfiTestResults, \
VerificationTest[MatchQ[QSFIPBH`ContourTrapezoid[{1., 2.}, {1.}], \n   \
_Failure], True, TestID -> \"quadrature-shape-validation\"]]"}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[{"AppendTo[qsfiTestResults, \
VerificationTest[MatchQ[QSFIPBH`GeneralizedCNu[0.5*I, -1.], _Failure], \n  \
True, TestID -> \"cnu-domain\"]]"}]], "Input", InitializationCell -> True], 
  Cell[BoxData[RowBox[{"AppendTo[qsfiTestResults, VerificationTest[\n  And @@ \
Table[propClose[QSFIPBH`GeneralizedCNu[0.5*I, ToExpression[r], 0., 30], \n    \
 propComplex[propReference[r][\"Cnu\"]]], {r, {\"0.3\", \"1.0\", \"3.0\"}}], \
True, \n  TestID -> \"cnu-three-sound-speed-branches\"]]"}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[{"propGrids = Association[Table[r -> \
QSFIPBH`BuildMixedGrid[0.5, Join[propSettings, \n       Association[\"c_phi\" \
-> If[r == \"0.3\", 0.3, 1.], \"c_sigma\" -> If[r == \"3.0\", 1./3, 1.]]]], \
\n    {r, {\"0.3\", \"1.0\", \"3.0\"}}]]; "}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[{"AppendTo[qsfiTestResults, VerificationTest[\n  And @@ \
Table[Max[Abs[propGrids[r][\"z_plus\"] - propComplex /@ \
propReference[r][\"z\"]]] < 1.*^-13, \n    {r, Keys[propGrids]}], True, \
TestID -> \"wick-contour-reference-agreement\"]]"}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[{"AppendTo[qsfiTestResults, VerificationTest[\n  And @@ \
Table[Max[Abs[propGrids[r][\"Iplus\"] - propComplex /@ \
propReference[r][\"I\"]]] < 2.*^-9, \n    {r, Keys[propGrids]}], True, TestID \
-> \"mixed-propagator-three-sound-speeds\"]]"}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[{"AppendTo[qsfiTestResults, VerificationTest[\n  And @@ \
Table[Max[Abs[QSFIPBH`MixedPropagator[propGrids[r], 0.2][\"Iplus\"] - \n      \
  propComplex /@ propReference[r][\"Iratio\"]]] < 2.*^-9, {r, \
Keys[propGrids]}], True, \n  TestID -> \
\"extended-argument-tail-reference-agreement\"]]"}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[{"propBundles = Association[Table[r -> \
QSFIPBH`BuildRatioBundle[propGrids[r], 0.02, 7], \n    {r, \
Keys[propGrids]}]]; "}]], "Input", InitializationCell -> True], 
  Cell[BoxData[RowBox[{"AppendTo[qsfiTestResults, \
VerificationTest[MatchQ[QSFIPBH`RatioEvaluate[propBundles[\"1.0\"], \n    \
\"i_plus\", 0.001], Failure[\"RatioDomain\", _Association]], True, \n  TestID \
-> \"ratio-domain-no-extrapolation\"]]"}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[{"AppendTo[qsfiTestResults, VerificationTest[With[{b = \
propBundles[\"1.0\"]}, \n   Max[Abs[QSFIPBH`RatioEvaluate[b, \"i_plus\", \
Sqrt[b[\"ratios\"][[2]]*b[\"ratios\"][[3]]]] - \n       (b[\"i_plus\"][[2]] + \
b[\"i_plus\"][[3]])/2]] < 1.*^-12], True, \n  TestID -> \
\"interpolation-linear-in-log-ratio\"]]"}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[{"AppendTo[qsfiTestResults, VerificationTest[\n  And @@ \
Table[propClose[QSFIPBH`BispectrumShape[propBundles[r], 0.6, 0.8, 1.], \n     \
propReference[r][\"bispectrum\"]], {r, Keys[propGrids]}], True, \n  TestID -> \
\"full-bispectrum-reference-agreement\"]]"}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[{"AppendTo[qsfiTestResults, VerificationTest[\n  And @@ \
Table[propClose[QSFIPBH`ContactShape[propBundles[r], {1., 0.9, 0.8, 1.2}], \n \
    propReference[r][\"contact\"]], {r, Keys[propGrids]}], True, \n  TestID \
-> \"full-contact-reference-agreement\"]]"}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[
     {"propVectors = QSFIPBH`FourMomentumVectors[1., 0.9, 0.8, -0.2, 0.3, \
1.1]; "}]], "Input", InitializationCell -> True], 
  Cell[BoxData[RowBox[{"AppendTo[qsfiTestResults, \
VerificationTest[Max[Abs[Total[propVectors]]] < 1.*^-14, True, \n  TestID -> \
\"four-momentum-closure\"]]"}]], "Input", InitializationCell -> True], 
  Cell[BoxData[RowBox[{"AppendTo[qsfiTestResults, VerificationTest[\n  And @@ \
Table[propClose[QSFIPBH`ExchangeShape[propBundles[r], propVectors], \n     \
propReference[r][\"exchange\"]], {r, Keys[propGrids]}], True, \n  TestID -> \
\"full-three-channel-exchange-reference-agreement\"]]"}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[{"AppendTo[qsfiTestResults, VerificationTest[\n  And @@ \
Table[Max[Abs[Take[QSFIPBH`SqueezedCoefficients[propGrids[r]], 2] - \n        \
Take[propReference[r][\"squeezed\"], 2]]] < 1.*^-9, {r, Keys[propGrids]}], \
True, \n  TestID -> \"squeezed-diagnostics-reference-agreement\"]]"}]], 
   "Input", InitializationCell -> True], 
  Cell[BoxData[RowBox[{"AppendTo[qsfiTestResults, VerificationTest[\n  And @@ \
