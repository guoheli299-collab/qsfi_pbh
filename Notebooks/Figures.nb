Rectangle[{j - 0.3, 0}, {j - 0.02, s3[[j]]}]}, \n       {$Burgundy, \
Rectangle[{j + 0.02, 0}, {j + 0.3, s4[[j]]}]}}, {j, n}]; \n    \
Legended[Graphics[{primitives, GrayLevel[0.45], Line[{{0.5, 0}, {n + 0.5, \
