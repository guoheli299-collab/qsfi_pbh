MapThread[QSFIPBH`BispectrumShape[bundle, #1, #2, 1.] & , {x, y}]; \n     fit \
= projectionCoreFailure[raw]; If[FailureQ[fit], Throw[fit, projectionAbort]]; \
\n     If[ !VectorQ[raw, projectionFiniteQ], \
Throw[projectionFailure[\"CMBShape\", \n        \"Full cubic CMB shape \
