  Cell[BoxData[RowBox[{"ReproduceReference[directory_:Automatic] := \n  \
Catch[Module[{out, c, rows, extrema, pbh, cmb, figures, manifest, result, \
paths = {}, source, \n     cases, deltaAxis, peakAxis}, \n    out = \
If[directory === Automatic, FileNameJoin[{$ProjectRoot, \"reference_run\"}], \
\n       ExpandFileName[directory]]; EnsureDirectory[out]; \n     \
EnsureDirectory[FileNameJoin[{out, \"data\"}]]; \
EnsureDirectory[FileNameJoin[{out, \"figures\"}]]; \n     manifest = \
Association[\"status\" -> \"running\", \"method\" -> \
\"archived_coefficients_and_cmb_fit\", \n       \"cold_qmc_run\" -> False, \
\"runtime\" -> $Version, \"native_wolfram_language\" -> True, \n       \
\"input_sha256\" -> Association[Table[FileNameTake[file] -> IntegerString[\n  \
          FileHash[file, \"SHA256\"], 16, 64], {file, Select[FileNames[\"*\", \
\n             FileNameJoin[{$ProjectRoot, \"reference_outputs\", \
\"inputs\"}]], \n            FileType[#1] === File & ]}]]]; \n     \
WriteJSON[FileNameJoin[{out, \"reference_run_manifest.json\"}], manifest]; \n \
    result = Catch[c = ProductionConfig[]; rows = ReadArchivedCoefficients[]; \
\n        require[ListQ[rows], \"InputData\", \"Archived coefficients could \
not be read.\"]; \n        extrema = ComputeExtrema[rows, c]; pbh = \
ComputePBHConstraints[rows]; \n        cmb = \
