DensityVarianceResponse[c[\"lognormal_delta\"], c[\"k_peak_r\"]]; \n     axis \
= Subdivide[c[\"lambda3_min\"], c[\"lambda3_max\"], c[\"lambda3_points\"] - \
1]; \n     yaxis = Subdivide[c[\"lambda4_min\"], c[\"lambda4_max\"], \
c[\"lambda4_points\"] - 1]; \n     dc = c[\"delta_c\"]; limit = \
Min[c[\"qng_max\"], 3/dc]; mixing = c[\"lambda2_over_H\"]; \n     Table[l4 = \
If[row[\"C4_contact_hat\"] < 0, First[yaxis], Last[yaxis]]; \n       values = \
CumulantsFromCoefficients[row, axis, l4, area, mixing, dc]; \n       \
require[AssociationQ[values], \"Cumulants\", \n        \"Cannot compute \
extrema from invalid coefficients.\"]; \n       index = \
First[Ordering[values[\"QNG\"], -1]]; l3 = axis[[index]]; \n       \
If[values[\"QNG\"][[index]] > limit, slope = \
dc*mixing^4*(row[\"C4_contact_hat\"]/(4*area)); \n         makeCandidate[x_] \
