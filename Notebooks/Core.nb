row[\"r_s\"], \"nu_tilde\" -> row[\"nu_tilde\"], \"lambda3_over_H\" -> l3, \n \
       \"lambda4\" -> l4, \"S3\" -> point[\"S3\"], \"S4\" -> point[\"S4\"], \
\"Q_NG\" -> q, \n        \"peak_ratio\" -> RequiredPowerRatio[q, \
