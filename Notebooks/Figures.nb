  Text[Style[Subscript[\"\[Delta]\", \"\[Phi]\"], 14], end + 0.08*d]}]; \n    \
panel[type_] := Module[{v = {0.5, 0.47}, a = {0.32, 0.47}, b = {0.68, 0.47}, \
content, title, \n       order}, Switch[type, 1, content = {(leg[v, #1] & ) \
/@ {{0.1, 0.85}, {0.9, 0.85}, \n             {0.5, 0.03}}, vertex[v, \
Subscript[\"\[Lambda]\", 3], {0.14, -0.02}]}; title = \"(a) Bispectrum\"; \n  \
       order = \"(\[Lambda]\:2082/H)\263 (\[Lambda]\:2083/H)\", 2, \n        \
content = {(leg[v, #1] & ) /@ {{0.1, 0.85}, {0.9, 0.85}, {0.1, 0.05}, {0.9, \
