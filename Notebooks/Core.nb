         If[slope == 0, j = Length[yaxis], bound = (limit - base)/slope; j = \
If[slope > 0, \n                Floor[((bound - First[yaxis])/(Last[yaxis] - \
First[yaxis]))*(Length[yaxis] - 1)] + \n                 1, Ceiling[((bound - \
First[yaxis])/(Last[yaxis] - First[yaxis]))*(Length[yaxis] - \n               \
     1)] + 1]; j = Clip[j, {1, Length[yaxis]}]]; yy = yaxis[[j]]; \n          \
  pt = CumulantsFromCoefficients[row, x, yy, area, mixing, dc]; \n            \
If[pt[\"QNG\"] > limit && slope != 0, j -= Sign[slope]; If[1 <= j <= \
Length[yaxis], \n               yy = yaxis[[j]]; pt = \
CumulantsFromCoefficients[row, x, yy, area, mixing, dc]]]; \n            \
If[pt[\"QNG\"] <= limit && slope != 0, neighbor = j + Sign[slope]; If[1 <= \
