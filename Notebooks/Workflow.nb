  Cell[BoxData[RowBox[{"ValidateObservationData[input_, expectedBins_:171] := \
\n  Catch[Module[{required = {\"x\", \"y\", \"data\", \"cov\"}, values, x, y, \
measured, cov, n, tolerance, \n     validationFit, fail, covScale, \
asymmetry}, \n    fail[tag_, message_] := Throw[Failure[tag, \
Association[\"MessageTemplate\" -> message]]]; \n     If[ \
!AssociationQ[input] ||  !AllTrue[required, KeyExistsQ[input, #1] & ], \n     \
 fail[\"ObservationSchema\", \"Observations must contain x, y, data and cov \
arrays.\"]]; \n     values = Lookup[input, required]; {x, y, measured, cov} = \
values; \n     If[ !VectorQ[x, observationFiniteRealQ] || x === {} ||  \
!VectorQ[y, observationFiniteRealQ] || \n        !VectorQ[measured, \
observationFiniteRealQ], fail[\"ObservationNumbers\", \n       \"Coordinates \
and measured data must be nonempty finite real numerical vectors.\"]]; \n     \
n = Length[x]; If[Length[y] != n || Length[measured] != n || \n        \
!MatrixQ[cov, observationFiniteRealQ] || Dimensions[cov] != {n, n}, \n      \
fail[\"ObservationDimensions\", \n       \"Observation vectors and the square \
full covariance must have matching dimensions.\"]]; \n     If[expectedBins \
=!= Automatic && ( !IntegerQ[expectedBins] || n != expectedBins), \n      \
fail[\"ObservationBins\", \n       \"Observation bin count does not match the \
expected released dataset.\"]]; \n     tolerance = 64*$MachineEpsilon; \n     \
If[ !And @@ MapThread[Function[{xx, yy}, TrueQ[Inequality[0, Less, xx, \
LessEqual, 1] && \n            Inequality[0, Less, yy, LessEqual, 1] && xx <= \
yy + tolerance && \n            1 - yy <= xx + tolerance]], {x, y}], \
fail[\"ObservationCoordinates\", \"Triangle \\\ncoordinates must satisfy \
0<x<=y<=1 and 1-y<=x (up to rounding at triangle boundaries).\"]]; \n     \
covScale = Max[1., Max[Abs[Flatten[N[cov]]]]]; \n     asymmetry = \
Max[Abs[Flatten[N[cov - Transpose[cov]]]]]; \n     If[asymmetry > \
64*$MachineEpsilon*covScale, fail[\"ObservationCovariance\", \n       \"Full \
observation covariance must be symmetric.\"]]; \n     validationFit = \
QSFIPBH`FitTemplate[UnitVector[n, 1], ConstantArray[0., n], cov]; \n     \
If[FailureQ[validationFit], fail[\"ObservationCovariance\", \n       \"Full \
observation covariance must be positive definite.\"]]; \n     \
Join[KeyTake[input, required], Association[\"observation_validation\" -> \n   \
     Association[\"bins\" -> n, \"finite_real_arrays\" -> True, \
\"triangle_coordinates_valid\" -> \n          True, \
\"covariance_symmetric_within_roundoff\" -> True, \
\"covariance_positive_definite\" -> \n          True, \
\"covariance_absolute_asymmetry\" -> asymmetry, \
\"covariance_relative_asymmetry\" -> \n          asymmetry/covScale, \
\"positive_definiteness_check\" -> \"Native FitTemplate validation; \
\\\nnumerical working covariance symmetrized at roundoff level; original \
input arrays retained\"]]]]]; "}]], "Input", InitializationCell -> True], 
