\"standard_template_validation_requested\" -> \n        \
TrueQ[c[\"validate_standard_templates\"]], \"template_hash_algorithm\" -> \n  \
      \"Wolfram-Expression-SHA256\", \"template_sha256\" -> \
projectionHash[template], \n       \"evaluator_identity\" -> \
projectionEvaluatorIdentity[bundle], \"x\" -> x, \"y\" -> y, \n       \
\"shape_hat\" -> raw, \"template_per_lambda3\" -> template]]], \
projectionAbort]; "}]], "Input", InitializationCell -> True], 
  Cell[BoxData[RowBox[{"Null"}]], "Input", InitializationCell -> True], 
  Cell[BoxData[RowBox[{"RunCMBFit[outputDirectory_String, input_, \
overrides_:Association[]] := \n  Catch[Module[{out, data, c, settings, \
resolution, grid, ratios, rows, bundle, result, write, \n     fail, nu, r, \
propagator, rowIndex}, If[ !AssociationQ[overrides], \n      \
Throw[projectionFailure[\"Configuration\", \"CMB overrides must be an \
Association.\"], \n       projectionAbort]]; data = If[AssociationQ[input], \
input, If[StringQ[input], \n        Quiet[Check[Import[input, \
If[ToLowerCase[FileExtension[input]] == \"wxf\", \"WXF\", \n            \
\"RawJSON\"]], $Failed]], $Failed]]; \n     If[ !AssociationQ[data] ||  \
!AllTrue[{\"x\", \"y\", \"data\", \"cov\"}, KeyExistsQ[data, #1] & ], \n      \
Throw[projectionFailure[\"CMBData\", \"Supply a native Association, JSON or \
WXF containing \\\nx,y,data,cov; the input is read directly.\"], \
projectionAbort]]; \n     resolution = Lookup[overrides, \"resolution\", \
\"coarse\"]; \n     If[ !MemberQ[{\"coarse\", \"fine\"}, resolution], \
Throw[projectionFailure[\"Configuration\", \n        \"CMB resolution must be \
coarse or fine.\"], projectionAbort]]; \n     c = \
Join[Association[\"wick_pivot\" -> 4., \"wick_depth\" -> If[resolution == \
\"coarse\", 16., 20.], \n        \"tail_depth\" -> If[resolution == \
\"coarse\", 18., 22.], \"real_step\" -> \n         If[resolution == \
\"coarse\", 0.04, 0.02], \"vertical_step\" -> If[resolution == \"coarse\", \n \
         0.04, 0.02], \"nlog\" -> If[resolution == \"coarse\", 400, 650], \
\"xmin\" -> 10^(-6), \n        \"dps\" -> 35, \"c_phi\" -> 1., \"c_sigma\" -> \
1./3, \"i_epsilon\" -> 10^(-8), \"nu_tilde\" -> 0.1, \n        \"A_s\" -> \
2.1*^-9, \"lambda2_over_h\" -> 0.38], overrides]; settings = \
ProjectionSettings[c]; \n     If[FailureQ[settings], Throw[settings, \
projectionAbort]]; nu = c[\"nu_tilde\"]; \n     \
projectionEmit[Association[\"phase\" -> \"native_cmb\", \"event\" -> \
\"cmb_start\", \n       \"r_s\" -> c[\"c_phi\"]/c[\"c_sigma\"], \"nu_tilde\" \
-> nu, \"resolution\" -> resolution]]; \n     grid = \
QSFIPBH`BuildMixedGrid[nu, settings]; If[FailureQ[grid], Throw[grid, \
projectionAbort]]; \n     ratios = N[Sort[DeleteDuplicates[Join[data[\"x\"], \
data[\"y\"], {1.}]]]]; \n     If[ !VectorQ[ratios, projectionFiniteQ[#1] && \
Inequality[0, Less, #1, LessEqual, 1] & ], \n      \
Throw[projectionFailure[\"CMBData\", \"CMB ratios must be positive and no \
larger than one.\"], \n       projectionAbort]]; rows = Table[propagator = \
QSFIPBH`MixedPropagator[grid, \n          ratios[[rowIndex]]]; \
If[FailureQ[propagator], Throw[propagator, projectionAbort]]; \n        \
If[rowIndex == 1 || rowIndex == Length[ratios] || Mod[rowIndex, 10] == 0, \n  \
       projectionEmit[Association[\"phase\" -> \"native_cmb\", \"event\" -> \
\"cmb_ratio\", \n           \"r_s\" -> c[\"c_phi\"]/c[\"c_sigma\"], \
\"nu_tilde\" -> nu, \"sample_completed\" -> rowIndex, \n           \
\"sample_total\" -> Length[ratios]]]]; propagator, {rowIndex, \
Length[ratios]}]; \n     bundle = Association[\"z_plus\" -> grid[\"z_plus\"], \
\"ratios\" -> ratios, \n       \"i_plus\" -> Lookup[rows, \"Iplus\"], \
\"h1_plus\" -> Lookup[rows, \"H1_plus\"], \n       \"h2c_plus\" -> \
Lookup[rows, \"H2c_plus\"], \"nutilde\" -> nu, \"c_phi\" -> c[\"c_phi\"], \n  \
     \"c_sigma\" -> c[\"c_sigma\"], \"i_epsilon\" -> c[\"i_epsilon\"]]; \n    \
 result = FitCMBTemplate[bundle, data, c]; If[FailureQ[result], \n      \
Throw[result, projectionAbort]]; result = Join[result, \n       \
Association[\"resolution\" -> resolution, \"source\" -> \n         \"new \
native mixed grid; direct propagator at every observed ratio\", \n        \
\"ratio_interpolation\" -> \"Exact observed ratio nodes (no geometric-ratio \
interpolation)\", \n        \"native_wolfram_language\" -> True, \
\"configuration\" -> c]]; \n     out = ExpandFileName[outputDirectory]; \
QSFIPBH`EnsureDirectory[out]; \n     write = \
projectionSaveReloadable[FileNameJoin[{out, StringJoin[\"cmb_template_\", \
resolution, \n          \".wxf\"]}], KeyTake[result, {\"x\", \"y\", \
\"shape_hat\", \"template_per_lambda3\"}]]; \n     If[FailureQ[write], \
Throw[write, projectionAbort]]; projectionChecked[\n      \
projectionWriteJSON[FileNameJoin[{out, StringJoin[\"cmb_fit_\", resolution, \
\".json\"]}], \n       KeyDrop[result, {\"x\", \"y\", \"shape_hat\", \
\"template_per_lambda3\"}]]]; \n     projectionEmit[Association[\"phase\" -> \
\"native_cmb\", \"event\" -> \"cmb_complete\", \n       \"r_s\" -> \
c[\"c_phi\"]/c[\"c_sigma\"], \"nu_tilde\" -> nu, \"results_file\" -> \n       \
 FileNameJoin[{out, StringJoin[\"cmb_fit_\", resolution, \".json\"]}], \n     \
  \"sample_completed\" -> Length[ratios], \"sample_total\" -> \
Length[ratios]]]; result], \n   projectionAbort]; "}]], "Input", 
   InitializationCell -> True], Cell[BoxData[RowBox[{"Null"}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[{"RunExchangeConvergence[outputDirectory_String, \
overrides_:Association[]] := \n  Catch[Module[{out, config, settings, cases, \
reps, tolerance, identity, grid, \n     bundles = Association[], bundle, \
caseSettings, estimate, estimates = Association[], factor, \n     comparisons \
= Association[], pairs, names, first, second, scale, relative, test, \n     \
refinementAccepted, samplingAccepted, report, write, caseRecord, label, \
nodes}, \n    If[ !AssociationQ[overrides], \
Throw[projectionFailure[\"Configuration\", \n        \"Convergence overrides \
must be an Association.\"], projectionAbort]]; \n     config = \
projectionNormalizedConfig[Join[Association[\"c_phi\" -> 1., \"c_sigma\" -> \
1./3], \n        overrides]]; If[FailureQ[config], Throw[config, \
projectionAbort]]; config[\"c_phi\"] = 1.; \n     config[\"c_sigma\"] = 1./3; \
settings = ProjectionSettings[config]; \n     If[FailureQ[settings], \
Throw[settings, projectionAbort]]; \n     cases = Lookup[overrides, \
\"numerical_cases\", {Association[\"label\" -> \"m12_n128\", \n         \
\"sobol_power\" -> 12, \"ratio_nodes\" -> 128], Association[\"label\" -> \
\"m12_n256\", \n         \"sobol_power\" -> 12, \"ratio_nodes\" -> 256], \
Association[\"label\" -> \"m13_n256\", \n         \"sobol_power\" -> 13, \
\"ratio_nodes\" -> 256], Association[\"label\" -> \"m14_n256\", \n         \
\"sobol_power\" -> 14, \"ratio_nodes\" -> 256]}]; \n     reps = \
Lookup[overrides, \"fixed_replicates\", 6]; \n     tolerance = \
Lookup[overrides, \"relative_tolerance\", 0.03]; \n     If[ !IntegerQ[reps] \
|| reps < 2 ||  !projectionFiniteQ[tolerance] || tolerance <= 0 || \n        \
!ListQ[cases] || Length[cases] < 2 || \n        !AllTrue[cases, \
AssociationQ[#1] && StringQ[Lookup[#1, \"label\", None]] && \n           \
IntegerQ[Lookup[#1, \"sobol_power\", None]] && 1 <= #1[\"sobol_power\"] <= 24 \
&& \n           IntegerQ[Lookup[#1, \"ratio_nodes\", None]] && \
#1[\"ratio_nodes\"] >= 3 & ], \n      \
Throw[projectionFailure[\"Configuration\", \"Convergence requires at least \
two labeled numerical \\\ncases, >=2 fixed replicates and positive \
tolerance.\"], projectionAbort]]; \n     If[ !DuplicateFreeQ[Lookup[cases, \
\"label\"]], Throw[projectionFailure[\"Configuration\", \n        \
\"Convergence case labels must be unique.\"], projectionAbort]]; \n     out = \
ExpandFileName[outputDirectory]; QSFIPBH`EnsureDirectory[out]; \n     \
identity = projectionGridIdentity[0.1, settings]; \n     grid = \
projectionCache[FileNameJoin[{out, \"cache\", StringJoin[\"mixed_grid_\", \n  \
        projectionHash[identity], \".wxf\"]}], identity, Function[Null, \n    \
    QSFIPBH`BuildMixedGrid[0.1, settings]]]; If[FailureQ[grid], Throw[grid, \
projectionAbort]]; \n     factor = \
settings[\"power_area\"]/settings[\"lambda2_over_h\"]^4; \n     Do[label = \
caseRecord[\"label\"]; nodes = caseRecord[\"ratio_nodes\"]; \n       If[ \
!KeyExistsQ[bundles, ToString[nodes]], identity = Association[\"kind\" -> \
\"ratio_bundle\", \n           \"grid_sha256\" -> projectionHash[grid], \
\"minimum_ratio\" -> settings[\"ratio_floor\"], \n           \"node_count\" \
-> nodes]; bundle = projectionCache[FileNameJoin[{out, \"cache\", \n          \
   StringJoin[\"ratio_bundle_\", projectionHash[identity], \".wxf\"]}], \
identity, \n           Function[Null, QSFIPBH`BuildRatioBundle[grid, \
settings[\"ratio_floor\"], nodes]]]; \n         If[FailureQ[bundle], \
Throw[bundle, projectionAbort]]; bundles[ToString[nodes]] = bundle]; \n       \
bundle = bundles[ToString[nodes]]; caseSettings = Join[settings, \n         \
Association[\"ratio_nodes\" -> nodes, \"full_ratio_nodes\" -> nodes, \n       \
   \"sobol_power_exchange\" -> caseRecord[\"sobol_power\"], \
\"sobol_min_replicates_four_point\" -> \n           reps, \
\"sobol_max_replicates_four_point\" -> reps, \n          \
\"sobol_max_power_increment_four_point\" -> 0]]; \n       estimate = \
EstimateStage[bundle, \"exchange\", caseSettings, \n         \
FileNameJoin[{out, \"qmc_checkpoints\", \
projectionHash[{projectionCheckpointIdentity[\n              caseSettings], \
projectionEvaluatorIdentity[bundle]}], \"exchange.wxf\"}]]; \n       \
If[FailureQ[estimate], Throw[estimate, projectionAbort]]; estimates[label] = \
\n        Association[\"label\" -> label, \"sobol_power\" -> \
caseRecord[\"sobol_power\"], \n         \"ratio_nodes\" -> nodes, \
\"S4_per_lambda3_over_H_squared_exchange\" -> \n          \
estimate[\"coefficient\"], \
\"S4_per_lambda3_over_H_squared_exchange_standard_error\" -> \n          \
estimate[\"coefficient_standard_error\"], \"C4_exchange_hat\" -> \n          \
factor*estimate[\"coefficient\"], \"C4_exchange_hat_standard_error\" -> \n    \
      Abs[factor]*estimate[\"coefficient_standard_error\"], \"sampling\" -> \
estimate], \n      {caseRecord, cases}]; pairs = \
Join[Partition[Keys[estimates], 2, 1], \n       If[Length[cases] > 2, \
{{First[Keys[estimates]], Last[Keys[estimates]]}}, {}]]; \n     names = \
If[Lookup[cases, \"label\"] === {\"m12_n128\", \"m12_n256\", \"m13_n256\", \
\"m14_n256\"}, \n       {\"ratio_grid_128_to_256_at_m12\", \
\"sobol_m12_to_m13_at_n256\", \"sobol_m13_to_m14_at_n256\", \n        \
\"overall_m12_n128_to_m14_n256\"}, Table[StringJoin[\"refinement_\", \
ToString[j]], \n        {j, Length[pairs]}]]; Do[first = \
estimates[pairs[[j,1]]]; second = estimates[pairs[[j,2]]]; \n       scale = \
Max[Abs[first[\"C4_exchange_hat\"]], Abs[second[\"C4_exchange_hat\"]]]; \n    \
   relative = If[scale == 0, 0., Abs[second[\"C4_exchange_hat\"] - \
first[\"C4_exchange_hat\"]]/\n          scale]; test = \
CompareStageEstimates[first[\"sampling\"], second[\"sampling\"], \n         \
Association[\"relative_tolerance\" -> tolerance]]; If[FailureQ[test], \n      \
  Throw[test, projectionAbort]]; comparisons[names[[j]]] = \n        \
Association[\"from\" -> pairs[[j,1]], \"to\" -> pairs[[j,2]], \
\"relative_difference\" -> \n          relative, \"tolerance\" -> tolerance, \
\"passed\" -> TrueQ[relative <= tolerance], \n         \
\"uncertainty_aware_comparison\" -> test], {j, Length[pairs]}]; \n     \
refinementAccepted = AllTrue[Values[comparisons], TrueQ[#1[\"passed\"]] & ]; \
\n     samplingAccepted = AllTrue[Values[estimates], \
TrueQ[#1[\"sampling\"][\"precision_accepted\"]] & ]; \n     report = \
Association[\"purpose\" -> \"r_s=3, nu_tilde=.1 scalar-exchange convergence \
check\", \n       \"native_wolfram_language\" -> True, \"manuscript_usable\" \
-> False, \"nu_tilde\" -> 0.1, \n       \"sound_speed\" -> \
Association[\"ratio\" -> 3., \"c_phi\" -> 1., \"c_sigma\" -> 1./3], \n       \
\"fixed_replicates\" -> reps, \"adaptive_sobol_power_increment\" -> 0, \n     \
  \"relative_tolerance\" -> tolerance, \"normalization\" -> \n        \
Association[\"power_area\" -> settings[\"power_area\"], \"lambda2_over_H\" -> \
\n          settings[\"lambda2_over_h\"], \
\"barred_to_hatted_exchange_factor\" -> factor], \n       \"estimates\" -> \
estimates, \"comparisons\" -> comparisons, \"passed\" -> refinementAccepted, \
\n       \"sampling_precision_accepted\" -> samplingAccepted, \"accepted\" -> \
\n        refinementAccepted && samplingAccepted, \"configuration\" -> \
config]; \n     QSFIPBH`WriteJSON[FileNameJoin[{out, \
\"r3_nu0p1_exchange_convergence.json\"}], report]; report], \n   \
projectionAbort]; "}]], "Input", InitializationCell -> True], 
  Cell[BoxData[RowBox[{"End[]; "}]], "Input", InitializationCell -> True], 
  Cell[BoxData[RowBox[{"EndPackage[]; "}]], "Input", 
   InitializationCell -> True]}, WindowSize -> {1280, 900}, 
 DefaultNewCellStyle -> "Input", StyleDefinitions -> "Default.nb"]
