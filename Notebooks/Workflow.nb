  Cell[BoxData[RowBox[{"standaloneAtomic[path_String, expression_, \
format_String] := \n  Module[{temporary, written, readback, failure}, \n   \
failure = standaloneFailure[\"ResultStorage\", \"Could not reliably save the \
result file.\", \n      Association[\"file\" -> path]]; If[ \
!DirectoryQ[DirectoryName[path]], \n     \
If[Quiet[Check[CreateDirectory[DirectoryName[path], \
CreateIntermediateDirectories -> True], \n         $Failed]] === $Failed, \
Return[failure]]]; \n    temporary = FileNameJoin[{DirectoryName[path], \
StringJoin[\".\", FileNameTake[path], \".\", \n        CreateUUID[], \
\".tmp\"]}]; \n    written = Quiet[Check[Export[temporary, If[format == \
\"RawJSON\", standaloneJSON[expression], \n         expression], format], \
$Failed]]; If[ !StringQ[written] ||  !FileExistsQ[temporary] || \n      \
FileByteCount[temporary] == 0, If[FileExistsQ[temporary], \
DeleteFile[temporary]]; \n      Return[failure]]; readback = \
Quiet[Check[Import[temporary, format], $Failed]]; \n    If[readback === \
$Failed || (format == \"WXF\" && readback =!= expression), \n     \
DeleteFile[temporary]; Return[failure]]; \n    written = \
Quiet[Check[RenameFile[temporary, path, OverwriteTarget -> True], $Failed]]; \
\n    If[written === $Failed, If[FileExistsQ[temporary], \
DeleteFile[temporary]]; failure, path]]; "}]], "Input", 
   InitializationCell -> True], 
