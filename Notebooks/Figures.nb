scheme, color, \n     opt, row, legend}, require[MemberQ[{\"peak_ratio\", \
\"log10_beta_ratio\"}, quantity], \n      \"FigureQuantity\", \"Unsupported \
coupling-grid quantity.\"]; \n     ratios = DeleteDuplicates[Lookup[rows, \
\"r_s\"]]; \n     nus = DeleteDuplicates[Lookup[rows, \"nu_tilde\"]]; \n     \
area = AreaFromPeakHeight[c[\"reference_peak_height\"], \
c[\"lognormal_delta\"]]; \n     c2 = \
DensityVarianceResponse[c[\"lognormal_delta\"], c[\"k_peak_r\"]]; \n     \
palette = If[quantity == \"peak_ratio\", {RGBColor[0.22, 0.31, 0.42], White, \
\n        RGBColor[0.59, 0.32, 0.36]}, {RGBColor[0.95, 0.94, 0.91], \
RGBColor[0.68, 0.62, 0.56], \n        $Navy}]; scheme = If[quantity == \
\"peak_ratio\", \"RedBlueTones\", \"DeepSeaColors\"]; \n     panels = \
Table[selected = Select[rows, Abs[#1[\"r_s\"] - ratio] < 10^(-10) & ]; \n     \
   rowExtrema = Select[extrema, Abs[#1[\"r_s\"] - ratio] < 10^(-10) & ]; \n   \
     rangeValues = Flatten[Table[Module[{pt = CumulantsFromCoefficients[r, \
xx, yy, area, c[\n                \"lambda2_over_H\"]], qv}, qv = pt[\"S3\"] \
+ c[\"delta_c\"]*(pt[\"S4\"]/4); \n             If[qv > Min[c[\"qng_max\"], \
3/c[\"delta_c\"]], Nothing, If[quantity == \"peak_ratio\", \n               \
RequiredPowerRatio[qv, c[\"target_beta\"], c[\"gamma_collapse\"], \
c[\"delta_c\"]], \n               \
c[\"delta_c\"]^3*(qv/(6*area*c2*Log[10.]))]]], {r, selected}, \n           \
{xx, Subdivide[c[\"lambda3_min\"], c[\"lambda3_max\"], 20]}, \n           \
{yy, {c[\"lambda4_min\"], c[\"lambda4_max\"]}}]]; require[rangeValues =!= {} \
&& \n          VectorQ[rangeValues, NumericQ], \"FigureDomain\", \n         \
\"No valid numerical coupling values available for the color scale.\"]; \n    \
    range = {Min[Join[rangeValues, Lookup[rowExtrema, quantity]]], \
Max[rangeValues]}; \n        If[range[[1]] == range[[2]], range += {-1., \
1.}]; \n        color = With[{vrange = range, colorScheme = scheme}, \
Function[value, \n           ColorData[colorScheme][Clip[Rescale[value, \
vrange], {0, 1}]]]]; \n        Append[Table[row = SelectFirst[selected, \
Abs[#1[\"nu_tilde\"] - nu] < 10^(-10) & ]; \n           \
require[AssociationQ[row], \"FigureInput\", \n            \"The coupling grid \
is missing a sound-speed/mass panel.\"]; \n           opt = \
SelectFirst[rowExtrema, Abs[#1[\"nu_tilde\"] - nu] < 10^(-10) & ]; \n         \
  q = c[\"lambda2_over_H\"]^3*row[\"C3_hat\"]*(x/Sqrt[area]) + \
c[\"delta_c\"]*\n              \
c[\"lambda2_over_H\"]^4*((row[\"C4_contact_hat\"]*y + \
row[\"C4_exchange_hat\"]*x^2)/(4*\n                area)); expression = \
If[quantity == \"peak_ratio\", With[{a = 1 - c[\"delta_c\"]*(q/3), \n         \
      arg = c[\"gamma_collapse\"]^2/(2.*Pi*c[\"target_beta\"]^2)}, \
Piecewise[{\n                {ProductLog[arg]/arg, a == 0}}, \
ProductLog[arg]*(a/ProductLog[a*arg])]], \n             \
c[\"delta_c\"]^3*(q/(6*area*c2*Log[10.]))]; legend = None; \n           \
DensityPlot[Evaluate[expression], {x, c[\"lambda3_min\"], \
c[\"lambda3_max\"]}, \n            {y, c[\"lambda4_min\"], \
c[\"lambda4_max\"]}, ColorFunction -> color, \n            \
ColorFunctionScaling -> False, PlotRange -> range, PlotPoints -> 31, \
MaxRecursion -> 1, \n            RegionFunction -> With[{qexpr = q, limit = \
Min[c[\"qng_max\"], 3/c[\"delta_c\"]]}, \n              Function[{xx, yy, \
vv}, Evaluate[(qexpr /. {x -> xx, y -> yy}) <= limit]]], \n            Frame \
-> True, Axes -> False, BaseStyle -> {FontFamily -> \"Times\", FontSize -> \
11}, \n            FrameLabel -> {\"\[Lambda]\:2083/H\", If[nu == First[nus], \
